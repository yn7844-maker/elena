# Vercel + GitHub Actions 모두 입력 (Neon의 pooled PostgreSQL 연결 문자열)
DATABASE_URL=
# Vercel에만 입력. 비밀번호 20자 이상, 서명 키 32자 이상. 서로 다른 임의 값 사용.
ARCHIVE_PASSWORD=
SESSION_SECRET=
# 아래 4개는 GitHub Actions Secrets에만 입력
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NAVER_TREND_CLIENT_ID=
NAVER_TREND_CLIENT_SECRET=
